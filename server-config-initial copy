user  nobody;
worker_processes  1;

# This default error log path is compiled-in to make sure configuration parsing
# errors are logged somewhere, especially during unattended boot when stderr
# isn't normally logged anywhere. This path will be touched on every nginx
# start regardless of error log location configured here. See
# https://trac.nginx.org/nginx/ticket/147 for more info. 
#
#error_log  /var/log/nginx/error.log;
#

#pid        logs/nginx.pid;


events {
    worker_connections  128;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    #log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
    #                  '$status $body_bytes_sent "$http_referer" '
    #                  '"$http_user_agent" "$http_x_forwarded_for"';

    #access_log  logs/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    #keepalive_timeout  0;
    keepalive_timeout  65;

    gzip  on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml+rss;
    #charset_types text/html text/xml text/plain text/vnd.wap.wml application/javascript application/rss+xml;

    server {
        listen       80;
        server_name  ludesign.info www.ludesign.info annawebdev.pro;
	return 301 https://$host$request_uri;
    }

    server {
	listen 443 ssl;
	ssl_certificate		/var/db/acme/certs/ludesign.info/fullchain.cer;
	ssl_certificate_key	/var/db/acme/certs/ludesign.info/ludesign.info.key;
        server_name  ludesign.info www.ludesign.info;

	access_log	/var/log/nginx/designLucy_prod/access.log;
	error_log	/var/log/nginx/designLucy_prod/error.log error;

	root /home/wadm/prod/designLucy/www;
	index index.html;
	error_page 404 /404.html;

	location /images/ {
		root /home/wadm/prod/designLucy/www;
		autoindex off;
		expires 24h;
	}

	location ~ \.(js|css|html|woff2)$ {
		root /home/wadm/prod/designLucy/www;
		expires 24h;
	}

	location ^~ /.well-known/acme-challenge/ {
		default_type "text/plain";
		root /home/wadm/prod/designLucy/www;
	}

	#location = /.well-known/acme-challenge/ {
	#	return 404;
	#}
    }

    server {
	listen 443 ssl;
	#listen 80;
	ssl_certificate		/var/db/acme/certs/annawebdev.pro_ecc/fullchain.cer;
	ssl_certificate_key	/var/db/acme/certs/annawebdev.pro_ecc/annawebdev.pro.key;
        server_name annawebdev.pro; 

	access_log	/var/log/nginx/annawebdev.pro/access.log;
	error_log	/var/log/nginx/annawebdev.pro/error.log error;


	location ^~ /.well-known/acme-challenge/ {
		default_type "text/plain";
		root /home/wadm/www/annawebdev.pro/prod/www;
	}

	location / {
		proxy_pass http://127.0.0.1:3000/;
		proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
	}

	#root /home/wadm/www/annawebdev.pro/prod/site/src/app;
	#index index.html;
	#error_page 404 /404.html;

    }

    server {
        listen       30500;
        server_name  localhost;
	root /home/wadm/designLucy/www;
	index index.html;
	error_page 404 /404.html;
    }

    #server {
    #    listen       30600;
    #    server_name  localhost;

    #    location / {
    #    	proxy_pass http://127.0.0.1:4000;
    #    }
    #}
}
